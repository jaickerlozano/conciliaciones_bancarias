# Copiar a .env (no se versiona) y ajustar.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5180

POSTGRES_DB=conciliaciones
POSTGRES_USER=conciliaciones
POSTGRES_PASSWORD=conciliaciones
POSTGRES_PORT=5433
# Backend corriendo en tu máquina (uv) contra el Postgres de Docker:
DATABASE_URL=postgres://conciliaciones:conciliaciones@localhost:5433/conciliaciones

# Archivos reales del cliente (comando demo_cinema y tests). Por defecto ../ingresos_egresos_cartolas
# CONCILIACION_DATOS_DIR=
